# StudyBuddy Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# Database
# ============================================
DATABASE_URL="postgresql://dev:devpass@localhost:5432/studybuddy"

# ============================================
# Frontend (Next.js)
# ============================================

# NextAuth
NEXTAUTH_SECRET="your-secret-key-min-32-characters-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_OAUTH_CLIENT_ID="your-google-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"

# GCP (for production)
GCS_BUCKET="studybuddy-materials"
GCS_PROJECT_ID="your-gcp-project-id"
CLOUD_TASKS_QUEUE="studybuddy-jobs"
CLOUD_TASKS_LOCATION="us-central1"
ENABLE_GCS_STORAGE="false"
ALLOW_GCS_LOCAL_FALLBACK="true"
ENABLE_CLOUD_TASKS="false"

# AI Service URL
AI_SERVICE_URL="http://localhost:8000"
AI_INTERNAL_TOKEN="replace-with-shared-secret"

# ============================================
# AI Service (Python)
# ============================================

# LLM (Claude generates and grades everything)
# "mock" returns schema-valid placeholder output with no API calls (local runs, e2e).
LLM_PROVIDER="anthropic"  # anthropic or mock
ANTHROPIC_API_KEY="your-anthropic-api-key"
# Notes, examples, quizzes and exams
ANTHROPIC_MODEL="claude-opus-5-5"
# Validation, topic extraction, short-answer grading and voice drills
ANTHROPIC_FAST_MODEL="claude-haiku-5-5"
ANTHROPIC_EFFORT="medium"
ANTHROPIC_FAST_EFFORT="low"
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# Embeddings
# "local" runs BAAI/bge-small-en-v1.5 in-process (384 dims, no key).
# "openai" uses text-embedding-3-small (1536 dims) and needs OPENAI_API_KEY.
# After changing the provider or model, re-embed existing chunks from ai-service/:
#   uv run python scripts/reembed_chunks.py
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
# EMBEDDING_CACHE_DIR=""  # the Docker image bakes the model into /opt/models

# OpenAI (optional): only the realtime voice coach and the "openai" embedding provider.
# Without a key the voice coach is turned off (the token endpoint returns 503).
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_REALTIME_MODEL="gpt-realtime-mini"
OPENAI_REALTIME_VOICE="marin"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"

# Processing
ENABLE_PROCESSING=true  # set to false to skip PDF processing in dev
AUTO_EXTRACT_TOPICS_ON_CHUNK=false  # keep false for user-driven topic extraction flow

# Environment
ENVIRONMENT="development"  # development or production
PORT="8000"
